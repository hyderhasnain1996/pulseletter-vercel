# Copy to `.env.local` for local development, and set the same names in
# Vercel under Project → Settings → Environment Variables.

# --- Database (required) ---------------------------------------------------
# Vercel: Storage → Neon → Connect to Project. The integration adds
# POSTGRES_URL automatically and the app reads that, so there is usually
# nothing to set here. DATABASE_URL is also accepted and takes precedence.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Session signing (required) --------------------------------------------
# Generate one with:  npx auth secret
AUTH_SECRET=

# --- Username and password sign-in ----------------------------------------
# The default way in. Defaults to mllab / mllab when unset, so change these
# before putting anything private in the workspace.

APP_USERNAME=mllab
APP_PASSWORD=mllab

# --- Sign in by email link (optional) --------------------------------------
# Your Resend API key. The same key can also send newsletters below.
# Leave unset to offer only username-and-password sign-in.
# AUTH_RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Sign in with Google (optional) ----------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Authorised redirect URI: https://YOUR-APP.vercel.app/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- Sending newsletters (required to send) --------------------------------
# EMAIL_FROM must be at a domain verified in Resend. While testing you may use
# onboarding@resend.dev, which only delivers to the Resend account owner.
EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=PulseLetter <onboarding@resend.dev>

# --- Phone notifications (free) --------------------------------------------
# Readers tap "Notify me" at the foot of a full issue and new issues arrive on
# their phone. Delivery is handled by the browser vendors, so it costs nothing
# and needs no messaging account. The key pair proves the message came from
# this site; generate your own with:
#
#   npx web-push generate-vapid-keys
#
# The public key must be set twice, once for the server and once with the
# NEXT_PUBLIC_ prefix so the page can read it. Notifications also need
# DATABASE_URL, because subscriptions are stored there.

VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Automations (scheduled sends) -----------------------------------------
# Vercel calls /api/cron/run once a day (see vercel.json) and it sends any
# automation that is due. The route refuses to run unless CRON_SECRET is set,
# so an automation cannot be triggered by anyone who finds the URL.
#
# Set CRON_SECRET to any long random string. Vercel sends it back as
# "Authorization: Bearer <secret>" on its scheduled calls.
#
# SITE_ORIGIN is the address used in links inside scheduled sends. Without it
# the deployment URL is used, which changes per deploy.

CRON_SECRET=
SITE_ORIGIN=https://your-app.vercel.app

# --- Sending texts (optional) ----------------------------------------------
# Texts go through Twilio (https://twilio.com). Unlike email there is no free
# tier for real sending: a phone number costs about $1-2 a month plus a few
# cents per message. A trial account can only text numbers you have verified.
#
# From the Twilio console:
#   SMS_ACCOUNT_SID  Account SID, starts with "AC"
#   SMS_AUTH_TOKEN   Auth Token next to it
#   SMS_FROM         a number you bought, in +country format e.g. +15551234567

# SMS_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxx
# SMS_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# SMS_FROM=+15551234567
